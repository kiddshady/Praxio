{
  "name": "praxio",
  "productName": "Praxio",
  "version": "1.3.1",
  "description": "Medical records, prescriptions and test orders for a private practice. Data encrypted on disk, signed by hand.",
  "main": "main.cjs",
  "author": "Kidd Shady · Umbrovex Systems",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/tokens.test.mjs && node test/store.test.mjs && node test/format.test.mjs && node test/carpeta.test.mjs && node test/hoja.test.mjs",
    "test:datos": "electron test/datos.test.cjs",
    "test:compat": "electron test/compat.test.cjs",
    "humo": "electron test/humo.test.cjs",
    "icon": "electron build/make-icon.cjs",
    "build": "electron-builder --win --publish never",
    "test:paquete": "electron test/empaquetado.test.cjs"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.kiddshady.rx",
    "productName": "Praxio",
    "copyright": "Copyright © 2026 Kidd Shady · Umbrovex Systems",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "src/**/*",
      "renderer/**/*",
      "package.json",
      "!data/**",
      "!node_modules/better-sqlite3-multiple-ciphers/deps/**",
      "!node_modules/better-sqlite3-multiple-ciphers/src/**",
      "!node_modules/better-sqlite3-multiple-ciphers/prebuilds/{darwin,linux,linuxmusl}-*.node",
      "!node_modules/better-sqlite3-multiple-ciphers/prebuilds/win32-arm64.node",
      "!test/**",
      "!dist/**"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3-multiple-ciphers/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "kiddshady",
      "repo": "Praxio"
    }
  }
}
